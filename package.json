{
  "name": "llm-inference-logging-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy && next build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push",
    "worker:ingest": "dotenv -e .env -- tsx src/workers/ingest-worker.ts",
    "worker:quality-score": "dotenv -e .env -- tsx src/workers/quality-score-worker.ts",
    "worker:ambient-insight": "dotenv -e .env -- tsx src/workers/ambient-insight-worker.ts",
    "worker:embedding": "dotenv -e .env -- tsx src/workers/embedding-worker.ts",
    "worker:scheduled-prompt": "dotenv -e .env -- tsx src/workers/scheduled-prompt-worker.ts",
    "worker:prompt-lab": "dotenv -e .env -- tsx src/workers/prompt-lab-worker.ts",
    "eval:run": "node evals/run.mjs",
    "eval:report": "cat evals/latest-report.json",
    "seed:admin": "dotenv -e .env -- node scripts/seed-admin.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@google/genai": "^0.14.1",
    "@prisma/client": "^6.8.2",
    "bullmq": "^5.10.3",
    "ioredis": "^5.4.1",
    "next": "^15.5.18",
    "openai": "^6.44.0",
    "prisma": "^6.8.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
