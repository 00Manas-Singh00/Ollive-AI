generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  VIEWER
  ANALYST
  PROMPT_EDITOR
  ADMIN
}

enum BudgetAction {
  WARN
  DOWNGRADE
  BLOCK
}

enum InsightStatus {
  PENDING
  SENT
  DISMISSED
}

enum ToolCallStatus {
  PENDING
  SUCCESS
  ERROR
}

enum ConversationMemberRole {
  OWNER
  COLLABORATOR
  VIEWER
}

enum PromptExperimentStatus {
  RUNNING
  CONCLUDED_CHAMPION
  CONCLUDED_CHALLENGER
  ABORTED
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  name          String
  role            UserRole             @default(VIEWER)
  rateLimitExempt Boolean              @default(false)
  monthlyBudgetUsd Float?
  budgetAction     BudgetAction        @default(WARN)
  createdAt       DateTime             @default(now())
  conversations   Conversation[]
  annotations     MessageAnnotation[]
  embedTokens     EmbedToken[]
  insights        ProactiveInsight[]
  scheduledPrompts ScheduledPrompt[]
  conversationMemberships ConversationMember[]
}

model ProactiveInsight {
  id                     String        @id @default(cuid())
  userId                 String
  triggerReason          String
  suggestedMessage       String
  relatedConversationIds String[]      @default([])
  status                 InsightStatus @default(PENDING)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

model EmbedToken {
  id               String   @id @default(cuid())
  token            String   @unique
  userId           String
  name             String?
  promptProfileKey String?
  allowedOrigins   String[] @default([])
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id         String      @id @default(cuid())
  userId     String
  title      String
  status     String      @default("active")
  isArchived Boolean     @default(false)
  isPinned   Boolean     @default(false)
  folder     String?
  tags       String[]    @default([])
  shareToken String?     @unique
  replayMeta Json?
  rootConversationId String?
  isCollaborative Boolean @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  messages   ChatMessage[]
  logs       InferenceLog[]
  safetyLogs SafetyAuditLog[]
  promptDecisions PromptDecision[]
  report     ConversationReport?
  members    ConversationMember[]
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isArchived, isPinned, updatedAt])
}

model ConversationMember {
  id             String                 @id @default(cuid())
  conversationId String
  userId         String
  role           ConversationMemberRole @default(COLLABORATOR)
  createdAt      DateTime               @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model PromptProfile {
  id           String         @id @default(cuid())
  key          String         @unique
  description  String?
  activeVersion Int?
  createdAt    DateTime       @default(now())
  versions     PromptVersion[]

  @@index([key, activeVersion])
}

model PromptVersion {
  id              String   @id @default(cuid())
  profileId       String
  version         Int
  basePrompt      String
  variantA        String?
  variantB        String?
  abRatioA        Int      @default(50)
  modelOverrides  Json?
  isRollbackPoint Boolean  @default(false)
  createdAt       DateTime @default(now())

  profile PromptProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  championOf   PromptExperiment[] @relation("ExperimentChampion")
  challengerOf PromptExperiment[] @relation("ExperimentChallenger")

  @@unique([profileId, version])
  @@index([profileId, createdAt])
}

model PromptExperiment {
  id                  String                 @id @default(cuid())
  profileKey          String
  championVersionId   String
  challengerVersionId String
  trafficSplit        Float                  @default(0.1)
  status              PromptExperimentStatus @default(RUNNING)
  minSamples          Int                    @default(100)
  autoPromote         Boolean                @default(false)
  metrics             Json?
  concludedAt         DateTime?
  createdAt           DateTime               @default(now())

  championVersion   PromptVersion @relation("ExperimentChampion", fields: [championVersionId], references: [id], onDelete: Cascade)
  challengerVersion PromptVersion @relation("ExperimentChallenger", fields: [challengerVersionId], references: [id], onDelete: Cascade)

  @@index([profileKey, status])
}

model PromptDecision {
  id             String   @id @default(cuid())
  conversationId String
  profileKey     String
  version        Int
  variant        String
  model          String?
  resolvedPrompt String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([profileKey, version, variant])
}

model SafetyAuditLog {
  id             String   @id @default(cuid())
  conversationId String
  phase          String
  action         String
  reason         String?
  categories     String[] @default([])
  sample         String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([phase, action, createdAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  branchParentId String?
  createdAt      DateTime @default(now())

  conversation  Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  annotations   MessageAnnotation[]
  qualityScore  QualityScore?
  raceResults   RaceResult[]
  citations     MessageCitation[]
  reasoningTrace ReasoningTrace?
  widgetInteraction WidgetInteraction?
  branchParent   ChatMessage?  @relation("MessageBranch", fields: [branchParentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchChildren ChatMessage[] @relation("MessageBranch")
  embedding      MessageEmbedding?
  toolCalls      ToolCall[]

  @@index([conversationId, createdAt])
  @@index([branchParentId])
}

model RaceResult {
  id         String   @id @default(cuid())
  messageId  String
  provider   String
  model      String
  content    String
  latencyMs  Int
  tokenCount Int?
  votedBest  Boolean  @default(false)
  createdAt  DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ReasoningTrace {
  id        String   @id @default(cuid())
  messageId String   @unique
  provider  String
  steps     Json
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model WidgetInteraction {
  id           String   @id @default(cuid())
  messageId    String   @unique
  widgetType   String
  schema       Json
  userResponse Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
}

model ToolCall {
  id        String         @id @default(cuid())
  messageId String
  toolName  String
  arguments Json
  result    Json?
  status    ToolCallStatus @default(PENDING)
  latencyMs Int?
  createdAt DateTime       @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model QualityScore {
  id         String   @id @default(cuid())
  messageId  String   @unique
  message    ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  score      Int
  breakdown  Json
  reason     String?
  createdAt  DateTime @default(now())

  @@index([score])
}

model MessageAnnotation {
  id        String   @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int?
  thumbs    String?
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, userId])
  @@index([messageId])
}

model InferenceLog {
  id                String   @id @default(cuid())
  eventId           String   @unique
  conversationId    String
  provider          String
  model             String
  status            String
  latencyMs         Int
  ttftMs            Int?
  streamDurationMs  Int?
  mode              String?
  promptTokens      Int?
  completionTokens  Int?
  totalTokens       Int?
  inputPreview      String
  outputPreview     String?
  errorMessage      String?
  requestTs         DateTime
  responseTs        DateTime
  createdAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([provider, model])
  @@index([status, createdAt])
}

model IngestionEvent {
  id             String   @id
  conversationId String
  status         String
  createdAt      DateTime @default(now())
  processedAt    DateTime?

  @@index([conversationId, createdAt])
}

model KnowledgeDocument {
  id             String           @id @default(cuid())
  conversationId String?
  userId         String
  filename       String
  content        String           @db.Text
  createdAt      DateTime         @default(now())
  chunks         KnowledgeChunk[]

  @@index([userId, conversationId])
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  chunkIndex Int
  text       String            @db.Text
  // embedding stored as JSON float array; upgrade path: migrate to pgvector Float[] with pg_vector extension
  embedding  Json?
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  citations  MessageCitation[]

  @@index([documentId])
}

model MessageCitation {
  id             String   @id @default(cuid())
  messageId      String
  chunkId        String
  relevanceScore Float
  excerptStart   Int
  excerptEnd     Int
  createdAt      DateTime @default(now())

  message ChatMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chunk   KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([chunkId])
}

model IngestionDLQ {
  id             String   @id @default(cuid())
  eventId        String
  conversationId String
  payload        String
  reason         String
  retryCount     Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([eventId])
  @@index([conversationId, createdAt])
}

model SpendCache {
  id       String @id @default(cuid())
  userId   String
  // month keyed as "YYYY-MM" — rollover is automatic, no cron needed
  month    String
  spendUsd Float  @default(0)

  @@unique([userId, month])
}

model ConversationReport {
  id                       String   @id @default(cuid())
  conversationId           String   @unique
  report                   Json
  model                    String
  generatedAt              DateTime @default(now())
  messageCountAtGeneration Int

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model ScheduledPrompt {
  id                      String    @id @default(cuid())
  userId                  String
  cronExpression          String
  prompt                  String
  provider                String
  isActive                Boolean   @default(true)
  lastRunAt               DateTime?
  deliveryConversationId  String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model MessageEmbedding {
  id         String   @id @default(cuid())
  messageId  String   @unique
  // embedding stored as JSON float array; upgrade path: pgvector Unsupported("vector(768)")
  vector     Json
  // embedding model name so a model swap can invalidate stale vectors
  model      String
  embeddedAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([embeddedAt])
}
