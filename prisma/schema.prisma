generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  VIEWER
  ANALYST
  PROMPT_EDITOR
  ADMIN
}

model User {
  id            String               @id @default(cuid())
  email         String               @unique
  name          String
  role            UserRole             @default(VIEWER)
  rateLimitExempt Boolean              @default(false)
  createdAt       DateTime             @default(now())
  conversations   Conversation[]
  annotations     MessageAnnotation[]
  embedTokens     EmbedToken[]
}

model EmbedToken {
  id               String   @id @default(cuid())
  token            String   @unique
  userId           String
  name             String?
  promptProfileKey String?
  allowedOrigins   String[] @default([])
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id         String      @id @default(cuid())
  userId     String
  title      String
  status     String      @default("active")
  isArchived Boolean     @default(false)
  isPinned   Boolean     @default(false)
  folder     String?
  tags       String[]    @default([])
  shareToken String?     @unique
  replayMeta Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  messages   ChatMessage[]
  logs       InferenceLog[]
  safetyLogs SafetyAuditLog[]
  promptDecisions PromptDecision[]
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isArchived, isPinned, updatedAt])
}

model PromptProfile {
  id           String         @id @default(cuid())
  key          String         @unique
  description  String?
  activeVersion Int?
  createdAt    DateTime       @default(now())
  versions     PromptVersion[]

  @@index([key, activeVersion])
}

model PromptVersion {
  id              String   @id @default(cuid())
  profileId       String
  version         Int
  basePrompt      String
  variantA        String?
  variantB        String?
  abRatioA        Int      @default(50)
  modelOverrides  Json?
  isRollbackPoint Boolean  @default(false)
  createdAt       DateTime @default(now())

  profile PromptProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, version])
  @@index([profileId, createdAt])
}

model PromptDecision {
  id             String   @id @default(cuid())
  conversationId String
  profileKey     String
  version        Int
  variant        String
  model          String?
  resolvedPrompt String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([profileKey, version, variant])
}

model SafetyAuditLog {
  id             String   @id @default(cuid())
  conversationId String
  phase          String
  action         String
  reason         String?
  categories     String[] @default([])
  sample         String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([phase, action, createdAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime @default(now())

  conversation  Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  annotations   MessageAnnotation[]
  qualityScore  QualityScore?
  raceResults   RaceResult[]

  @@index([conversationId, createdAt])
}

model RaceResult {
  id         String   @id @default(cuid())
  messageId  String
  provider   String
  model      String
  content    String
  latencyMs  Int
  tokenCount Int?
  votedBest  Boolean  @default(false)
  createdAt  DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model QualityScore {
  id         String   @id @default(cuid())
  messageId  String   @unique
  message    ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  score      Int
  breakdown  Json
  reason     String?
  createdAt  DateTime @default(now())

  @@index([score])
}

model MessageAnnotation {
  id        String   @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int?
  thumbs    String?
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([messageId, userId])
  @@index([messageId])
}

model InferenceLog {
  id                String   @id @default(cuid())
  conversationId    String
  provider          String
  model             String
  status            String
  latencyMs         Int
  ttftMs            Int?
  streamDurationMs  Int?
  mode              String?
  promptTokens      Int?
  completionTokens  Int?
  totalTokens       Int?
  inputPreview      String
  outputPreview     String?
  errorMessage      String?
  requestTs         DateTime
  responseTs        DateTime
  createdAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([provider, model])
  @@index([status, createdAt])
}

model IngestionEvent {
  id             String   @id
  conversationId String
  status         String
  createdAt      DateTime @default(now())
  processedAt    DateTime?

  @@index([conversationId, createdAt])
}

model KnowledgeDocument {
  id             String           @id @default(cuid())
  conversationId String?
  userId         String
  filename       String
  content        String           @db.Text
  createdAt      DateTime         @default(now())
  chunks         KnowledgeChunk[]

  @@index([userId, conversationId])
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  chunkIndex Int
  text       String            @db.Text
  // embedding stored as JSON float array; upgrade path: migrate to pgvector Float[] with pg_vector extension
  embedding  Json?
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}

model IngestionDLQ {
  id             String   @id @default(cuid())
  eventId        String
  conversationId String
  payload        String
  reason         String
  retryCount     Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([eventId])
  @@index([conversationId, createdAt])
}
