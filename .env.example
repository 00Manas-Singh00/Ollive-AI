# --- Core ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DB_NAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?sslmode=require"
REDIS_URL="redis://localhost:6379"
SESSION_SECRET="change-me-to-a-random-64-char-string-before-deploying-to-production"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Primary inference: any OpenAI-compatible endpoint (vLLM/SGLang/Ollama/etc.) ---
# Production: point at your vLLM/serverless-GPU endpoint. Dev: run `docker compose
# --profile ollama up` and set this to http://ollama:11434/v1 (or http://localhost:11434/v1
# outside compose), then `docker compose exec ollama ollama pull <model>`.
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_CHAT_MODEL=""
# Cheaper/faster model on the same endpoint for background jobs (judging, moderation,
# titles). Falls back to LLM_CHAT_MODEL when unset.
LLM_SMALL_MODEL=""
LLM_TEMPERATURE="0.9"
LLM_MAX_OUTPUT_TOKENS="2048"
LLM_CONTEXT_WINDOW="8"
# $/1k tokens for cost/budget tracking against the primary endpoint. Self-hosted
# inference has no metered bill by default, so both default to 0.
LLM_COST_IN_PER_1K="0"
LLM_COST_OUT_PER_1K="0"

# --- Backup inference: Gemini, used automatically only when the primary endpoint fails ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_THINKING_BUDGET="0"

# --- Legacy/manual-only providers (grok/openai/anthropic/ollama) ---
# Hidden from automatic failover; only reachable via an explicit providerOverride.
# Set to "true" to expose them in configuredProviders() / race mode / the admin UI.
ENABLE_EXTRA_PROVIDERS="false"
GROK_API_KEY=""
GROK_MODEL="grok-3-mini"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
ANTHROPIC_THINKING_BUDGET_TOKENS="4096"
OLLAMA_BASE_URL=""
OLLAMA_MODEL="llama3"

# --- Embeddings (RAG + semantic search) ---
# OpenAI-compatible /embeddings endpoint, e.g. nomic-embed-text or bge-m3 served by the
# same vLLM/Ollama instance. Falls back to a hashed term-frequency vector when unset or
# unreachable. EMBEDDING_DIM must match the model's actual output dimension and the
# pgvector column width (see prisma/migrations/..._phase_t9_pgvector).
EMBEDDING_BASE_URL=""
EMBEDDING_MODEL=""
EMBEDDING_DIM="768"
EMBEDDING_BATCH_SIZE="50"
EMBEDDING_CONCURRENCY="4"
SEARCH_MAX_VECTORS="5000"

# --- Speech ---
# Self-hosted OpenAI-compatible STT, e.g. `docker compose --profile whisper up`
# (WHISPER_BASE_URL=http://whisper:8000/v1 in compose, http://localhost:8000/v1 outside).
# Gemini is the backup when GEMINI_API_KEY is set; otherwise transcription returns 501.
WHISPER_BASE_URL=""
WHISPER_API_KEY=""
SPEECH_STT_PROVIDER=""
SPEECH_STT_MODEL=""
SPEECH_TTS_PROVIDER="openai"
SPEECH_TTS_MODEL="tts-1"
SPEECH_TTS_VOICE="alloy"

# --- Auth / admin seed ---
# Used by `npm run seed:admin` to create/update the admin account.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Ingestion ---
# External log producers only (the app's own logging enqueues in-process). 503s the
# route when unset.
INGEST_TOKEN=""
INGEST_MAX_RETRIES="5"
INGEST_RETRY_DELAY_MS="1000"

# --- Safety / quality judges ---
# "llm" runs a smallModel() classifier/rubric on the primary endpoint, failing open to
# the regex/heuristic path on any error. Default (unset) is the regex/heuristic path.
SAFETY_JUDGE=""
QUALITY_JUDGE=""
SAFETY_REFUSAL_TEMPLATE=""

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE="20"
RATE_LIMIT_PER_HOUR="200"
RATE_LIMIT_PER_DAY="1000"

# --- Budget guardrails ---
BUDGET_FALLBACK_PROVIDER=""
BUDGET_FALLBACK_MODEL=""

# --- Prompt profile / prompt lab ---
PROMPT_PROFILE_KEY="chat-default"
PROMPT_LAB_INTERVAL_MINUTES="60"
PROMPT_LAB_CONCURRENCY="2"

# --- Scheduled prompts ---
MAX_SCHEDULES_PER_USER="10"
SCHEDULED_PROMPT_CONCURRENCY="2"
SCHEDULED_PROMPT_CONTEXT_CONVERSATIONS="5"

# --- Ambient insights ---
AMBIENT_INSIGHT_INTERVAL_MINUTES="60"
AMBIENT_INSIGHT_CONCURRENCY="2"
AMBIENT_INSIGHT_LOOKBACK_HOURS="168"
AMBIENT_INSIGHT_MAX_CONVERSATIONS="12"
AMBIENT_INSIGHT_CONFIDENCE="0.7"
